# ─── Server ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ───────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/portfolio
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/portfolio

# ─── Auth ───────────────────────────────────────────────
# Long random string (at least 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Used ONLY by `npm run seed:admin` to create/update the admin account.
# The password is stored as a bcrypt hash; remove it from .env after seeding.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Email (Nodemailer) ─────────────────────────────────
# Gmail: enable 2-Step Verification, then create an App Password
# (Google Account → Security → App passwords) and use it as EMAIL_PASSWORD.
EMAIL_USER=
EMAIL_PASSWORD=
OWNER_EMAIL=
# Optional custom SMTP (leave empty to use Gmail)
EMAIL_HOST=
EMAIL_PORT=587
# Send an automatic "thanks, I received your message" email to visitors
SEND_ACK_EMAIL=true

# ─── CORS ───────────────────────────────────────────────
# Frontend origin(s), comma-separated, no trailing slash
CLIENT_URL=http://localhost:5173
